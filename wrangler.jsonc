// Cloudflare Workers configuration for the Morgan Lee website.
// The site is plain HTML/CSS/images, served as static assets (no Worker script).
{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "morgan-lee",
  "compatibility_date": "2026-11-01",

  // Serve the files in the project root (index.html, css/, images/).
  // Files listed in .assetsignore are not uploaded.
  "assets": {
    "directory": "./"
  },

  // Required by Workers Builds to run preview builds for pull requests.
  "previews": {}
}
